---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="page-hero" style="padding:110px 0">
    <div class="wrap">
      <h1>That page isn't in the binder</h1>
      <p>The link may be old or mistyped.</p>
      <div class="hero-cta">
        <a class="btn" href="/">Back to home</a>
        <a href="/blog/"><strong>Read the blog</strong></a>
      </div>
    </div>
  </section>
</Base>
